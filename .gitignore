# ===== Python =====
__pycache__/
*.py[cod]
*.pyo

# ===== windows =====
*.exe 
log.log
# ===== Virtual Environment =====
.venv/
venv/
env/

# ===== Environment variables =====
.env
.env.*

# ===== Ignore folder =====
**/đơn hàng/

build/
dist/

# Wails' GO/build/ holds tracked project config (icon.ico, installer
# scripts, platform manifests), not build output — keep it even though the
# generic build/ rule above would otherwise ignore it. The actual compiled
# binary output (GO/build/bin/) gets its own explicit ignore rule.
!GO/build/
# ===== OS =====
.DS_Store
Thumbs.db

# ===== IDE =====
.vscode/
.idea/


zalo_state.json
log.log

# ===== Chromedp Zalo session (chứa cookie đăng nhập thật, KHÔNG commit — xem
# ghi nhớ dự án "Zalo session leak incident") =====
zalo_profile/

# ===== Superpowers scratch (per-plan SDD ledgers/workspaces) =====
.superpowers/

# ===== Go (Wails) build artefacts =====
# GO/.gitignore already covers these locally; listed here too so the root
# .gitignore is self-describing. GO/build/bin/ sits after the !GO/build/
# exception above and only re-excludes the compiled-binary subfolder —
# GO/build/windows/icon.ico and other tracked Wails project config stay.
GO/frontend/node_modules/
GO/frontend/dist/
GO/build/bin/